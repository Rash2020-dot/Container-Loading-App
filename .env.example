# Server Port (defaults to 3000)
PORT=3000

# Brevo Transactional Email Settings (Optional)
# Never commit your real .env file to GitHub. Copy this file to .env and add your real values.
BREVO_API_KEY=your-brevo-api-key
SENDER_EMAIL=your-sender@example.com
# Comma-separated list of recipient email addresses
RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com
SENDER_NAME=Container Loading System

# APP_URL: Public URL where this app is hosted (optional)
APP_URL="http://localhost:3000"
